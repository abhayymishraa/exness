[Unit]
Description=exness websocket fanout
After=redis-server.service
Requires=redis-server.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/exness/ws
EnvironmentFile=/etc/exness/exness.env
Environment=PORT=8080
ExecStart=/usr/local/bin/bun run index.ts

Restart=always
RestartSec=3

MemoryMax=512M
SyslogIdentifier=exness-ws

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/exness/ws

[Install]
WantedBy=multi-user.target
