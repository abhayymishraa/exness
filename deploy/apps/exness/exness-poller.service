[Unit]
Description=exness binance price poller
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/exness/price_poller
EnvironmentFile=/etc/exness/exness.env
ExecStart=/usr/local/bin/bun run src/index.ts

# Upstream Binance WS drops connections routinely; always come back.
Restart=always
RestartSec=5

MemoryMax=512M
SyslogIdentifier=exness-poller

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/exness/price_poller

[Install]
WantedBy=multi-user.target
