# Server copy: /etc/exness/exness.env, chown root:ubuntu, chmod 640 (see deploy/README.md).
# Never committed. `newdb.sh exness` prints DATABASE_URL for you.

DATABASE_URL=postgresql://exness:CHANGEME@localhost:5432/exness_db
REDIS_URL=redis://localhost:6379/0

NODE_ENV=production

# Required — the app refuses to boot in production without it.
#   openssl rand -hex 32
JWT_SECRET=CHANGEME

# Comma-separated; a single-label wildcard is allowed for Vercel previews.
# Never a bare "*": credentials are on, so any site could act as a signed-in user.
CORS_ORIGINS=http://localhost:3000,https://exness.abhayymishraa.us,https://*.vercel.app

# Leave EMPTY: frontend and API are cross-site, a domain attr breaks login.
COOKIE_DOMAIN=
