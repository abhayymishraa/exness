# Lives on the server at /etc/exness/exness.env
#   chown root:ubuntu && chmod 640
# Group-readable on purpose: the services already run as ubuntu, and deploy.sh
# needs DATABASE_URL for the migration step. 600 root would lock out the deploy.
# Never committed. `newdb.sh exness` prints the first two lines for you.

DATABASE_URL=postgresql://exness:CHANGEME@localhost:5432/exness_db
REDIS_URL=redis://localhost:6379/0

NODE_ENV=production

# Required — the app refuses to boot in production without it.
#   openssl rand -hex 32
JWT_SECRET=CHANGEME

# IP-only mode: no browser frontend is deployed, so this only needs to cover
# local dev. Add the Vercel URL here the day the frontend ships.
CORS_ORIGINS=http://localhost:3000

# Leave EMPTY. A host-only cookie is correct for both IP access and a future
# cross-site Vercel frontend. Setting a domain here breaks login in both.
COOKIE_DOMAIN=
